import time

n = 1000
lista = list(range(n))
tupla = tuple(range(n))
dicionario = {i: f"val_{i}" for i in range(n)}

t1 = time.perf_counter()
for _ in range(n):
    _ = lista[50]
    _ = 50 in lista
    lista[50] = 0
    lista.append(0)
    lista.pop()
t2 = time.perf_counter()
print(f"Tempo Lista: {t2 - t1:.6f} s")

t1 = time.perf_counter()
for _ in range(n):
    _ = tupla[50]
    _ = 50 in tupla
t2 = time.perf_counter()
print(f"Tempo Tupla: {t2 - t1:.6f} s")

t1 = time.perf_counter()
for _ in range(n):
    _ = dicionario.get(50)
    _ = 50 in dicionario
    dicionario[50] = 0
    dicionario[9999] = 0
    del dicionario[9999]
t2 = time.perf_counter()
print(f"Tempo Dicionário: {t2 - t1:.6f} s")
