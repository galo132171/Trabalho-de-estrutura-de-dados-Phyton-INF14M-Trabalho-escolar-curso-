# Atividade 5 - Medição de Espaço
import tracemalloc

n = 1000

tracemalloc.start()
lista = list(range(n))
_ = lista[50]
_ = 50 in lista
lista[50] = 0
lista.append(0)
lista.pop()
_, pico_lista = tracemalloc.get_traced_memory()
tracemalloc.stop()
print(f"Pico do pick da Lista: {pico_lista / 1024 ** 2:.6f} MB")

tracemalloc.start()
tupla = tuple(range(n))
_ = tupla[50]
_ = 50 in tupla
_, pico_tupla = tracemalloc.get_traced_memory()
tracemalloc.stop()
print(f"Pico do pick da Tupla: {pico_tupla / 1024 ** 2:.6f} MB")

tracemalloc.start()
dicionario = {i: i for i in range(n)}
_ = dicionario.get(50)
_ = 50 in dicionario
dicionario[50] = 0
dicionario[9999] = 0
del dicionario[9999]
_, pico_dict = tracemalloc.get_traced_memory()
tracemalloc.stop()
print(f"Pico do pick da tupla Dicionário: {pico_dict / 1024 ** 2:.6f} MB")
