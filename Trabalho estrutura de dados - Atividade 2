# Atividade 2
nomes = []
notas = []

def adicionar(nome, nota):
    nomes.append(nome)
    notas.append(float(nota))
    print(f"Aluno {nome} adicionado, boa sorte!(Galo).")

def remover(nome):
    if nome in nomes:
        i = nomes.index(nome)
        nomes.pop(i)
        notas.pop(i)
        print(f"Aluno {nome} removido.")
    else:
        print("Aluno não encontrado, foi de vasco.")

def modificar(nome, nova_nota):
    if nome in nomes:
        i = nomes.index(nome)
        notas[i] = float(nova_nota)
        print(f"Nota de {nome} alterada para {nova_nota}.")
    else:
        print("Aluno não encontrado,foi de vasco")

def para_tuplas():
    return tuple(nomes), tuple(notas)

def mostrar(t_nomes, t_notas):
    print("\n--- Lista de Alunos ---")
    for i in range(len(t_nomes)):
        print(f"Nome: {t_nomes[i]} | Nota: {t_notas[i]}")

def consultar(t_nomes, t_notas, busca):
    if busca in t_nomes:
        i = t_nomes.index(busca)
        print(f"Nota do(a) {busca}: {t_notas[i]}")
    else:
        print("Aluno não encontrado,doi de vasco")

adicionar("João", 8.5)
adicionar("Maria", 9.0)
adicionar("Pedro", 7.0)

modificar("Pedro", 7.5)
remover("Maria")

t_nomes, t_notas = para_tuplas()

mostrar(t_nomes, t_notas)
consultar(t_nomes, t_notas, "carlos")
