# Atividade 7 - Desempenho temporal em Matriz
import time

linhas = 300
colunas = 600

matriz = []
for i in range(linhas):
    linha = []
    for j in range(colunas):
        linha.append(i + j)
    matriz.append(linha)

for i in range(len(matriz)):
    for j in matriz[i]:
        _ = j * 1

tempos = []
for _ in range(5):
    t1 = time.perf_counter()
    for i in range(len(matriz)):
        for j in matriz[i]:
            _ = j * 2
    t2 = time.perf_counter()
    tempos.append(t2 - t1)

print(f"Menor tempo: {min(tempos):.6f} s")
print(f"Tempo médio: {sum(tempos) / len(tempos):.6f} s")
